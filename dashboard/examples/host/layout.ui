<Column id="overview" gap="24dp">
<Column id="health" gap="4dp"><Text id="hostname" text={params.host} variant="heading"/><Status id="status" text={params.status} tone={params.statusTone}/><Text id="updated" text={params.updated} variant="caption" tone="muted"/></Column>
<Width id="metricswide" min="640dp"><Grid id="metricsGridwide" columns={2} gap="16dp"><Use id="cpuwide" definition="homelab-metric-card" params={params.cpu}/><Use id="memorywide" definition="homelab-metric-card" params={params.memory}/></Grid></Width>
<Width id="metricsnarrow" max="640dp"><Grid id="metricsGridnarrow" columns={1} gap="16dp"><Use id="cpunarrow" definition="homelab-metric-card" params={params.cpu}/><Use id="memorynarrow" definition="homelab-metric-card" params={params.memory}/></Grid></Width>
<Column id="storage" gap="12dp"><Text id="storageHeading" text="Storage" variant="heading"/><Text id="storageNote" text="Available disk space" variant="caption" tone="muted"/>
<Width id="storagewide" min="800dp"><For id="diskswide" items={params.disks} key={item.id} columns={3} gap="12dp"><Column id="diskwide" surface="card" padding="16dp" gap="4dp"><Text id="mountwide" text={item.mount}/><Text id="freewide" text={item.value} variant="metric" tone={item.tone}/><Text id="devicewide" text={item.device} variant="caption" tone="muted"/></Column></For></Width>
<Width id="storagemedium" min="480dp" max="800dp"><For id="disksmedium" items={params.disks} key={item.id} columns={2} gap="12dp"><Column id="diskmedium" surface="card" padding="16dp" gap="4dp"><Text id="mountmedium" text={item.mount}/><Text id="freemedium" text={item.value} variant="metric" tone={item.tone}/><Text id="devicemedium" text={item.device} variant="caption" tone="muted"/></Column></For></Width>
<Width id="storagenarrow" max="480dp"><For id="disksnarrow" items={params.disks} key={item.id} columns={1} gap="12dp"><Column id="disknarrow" surface="card" padding="16dp" gap="4dp"><Text id="mountnarrow" text={item.mount}/><Text id="freenarrow" text={item.value} variant="metric" tone={item.tone}/><Text id="devicenarrow" text={item.device} variant="caption" tone="muted"/></Column></For></Width>
</Column></Column>
