<Column id="overview" gap="24dp">
<Column id="health" gap="4dp"><Text id="hostname" text={params.host} variant="heading"/><Status id="status" text={params.status} tone={params.statusTone}/><Text id="updated" text={params.updated} variant="caption" tone="muted"/></Column>
<Width id="metricswide" min="640dp"><Grid id="metricsGridwide" columns={2} gap="16dp"><Use id="cpuwide" definition="host-metric-card" params={params.cpu}/><Use id="memorywide" definition="host-metric-card" params={params.memory}/></Grid></Width>
<Width id="metricsnarrow" max="640dp"><Grid id="metricsGridnarrow" columns={1} gap="16dp"><Use id="cpunarrow" definition="host-metric-card" params={params.cpu}/><Use id="memorynarrow" definition="host-metric-card" params={params.memory}/></Grid></Width>
<If id="withRepository" when={params.repositories.visible}><Column id="storageAndRepositories">
<Width id="storageRowWide" min="800dp"><Grid id="storageRowGrid" columns={2} gap="24dp"><Column id="storage" gap="12dp"><Text id="storageHeading" text="Storage" variant="heading"/><Text id="storageNote" text="Available disk space" variant="caption" tone="muted"/>
<For id="disksmedium" items={params.disks} key={item.id} columns={2} gap="12dp"><Column id="diskmedium" surface="card" padding="16dp" gap="4dp"><Text id="mountmedium" text={item.mount}/><Text id="freemedium" text={item.value} variant="metric" tone={item.tone}/><Text id="capacitymedium" text={item.detail} variant="caption" tone="muted"/><Text id="devicemedium" text={item.device} variant="caption" tone="muted"/></Column></For></Column><If id="repositoryCheck" when={params.repositories.visible}><Column id="repositoryCard" surface="card" padding="16dp" gap="4dp"><Status id="repositoryStatus" text={params.repositories.title} tone={params.repositories.tone}/><Text id="repositorySummary" text={params.repositories.summary}/><Text id="repositoryChecked" text={params.repositories.checked} variant="caption" tone="muted"/><If id="repositoryAction" when={params.repositories.canCheck}><Column id="repositoryActionContent" gap="4dp"><Button id="repositoryCheckNow" text={params.repositories.checkLabel} enabled={params.repositories.checkEnabled} onClick={actions.checkRepositories}/><Status id="repositoryCheckMessage" text={params.repositories.checkMessage} tone="muted"/></Column></If><Text id="repositoryLastClean" text={params.repositories.lastClean} variant="caption" tone="muted"/></Column></If></Grid></Width>
<Width id="storageRowNarrow" max="800dp"><Column id="storageRowStack" gap="24dp"><Column id="storageStack" gap="12dp"><Text id="storageHeadingStack" text="Storage" variant="heading"/><Text id="storageNoteStack" text="Available disk space" variant="caption" tone="muted"/>
<Width id="storagewideStack" min="800dp"><For id="diskswideStack" items={params.disks} key={item.id} columns={3} gap="12dp"><Column id="diskwideStack" surface="card" padding="16dp" gap="4dp"><Text id="mountwideStack" text={item.mount}/><Text id="freewideStack" text={item.value} variant="metric" tone={item.tone}/><Text id="capacitywideStack" text={item.detail} variant="caption" tone="muted"/><Text id="devicewideStack" text={item.device} variant="caption" tone="muted"/></Column></For></Width>
<Width id="storagemediumStack" min="480dp" max="800dp"><For id="disksmediumStack" items={params.disks} key={item.id} columns={2} gap="12dp"><Column id="diskmediumStack" surface="card" padding="16dp" gap="4dp"><Text id="mountmediumStack" text={item.mount}/><Text id="freemediumStack" text={item.value} variant="metric" tone={item.tone}/><Text id="capacitymediumStack" text={item.detail} variant="caption" tone="muted"/><Text id="devicemediumStack" text={item.device} variant="caption" tone="muted"/></Column></For></Width>
<Width id="storagenarrowStack" max="480dp"><For id="disksnarrowStack" items={params.disks} key={item.id} columns={1} gap="12dp"><Column id="disknarrowStack" surface="card" padding="16dp" gap="4dp"><Text id="mountnarrowStack" text={item.mount}/><Text id="freenarrowStack" text={item.value} variant="metric" tone={item.tone}/><Text id="capacitynarrowStack" text={item.detail} variant="caption" tone="muted"/><Text id="devicenarrowStack" text={item.device} variant="caption" tone="muted"/></Column></For></Width>
</Column><If id="repositoryCheckStack" when={params.repositories.visible}><Column id="repositoryCardStack" surface="card" padding="16dp" gap="4dp"><Status id="repositoryStatusStack" text={params.repositories.title} tone={params.repositories.tone}/><Text id="repositorySummaryStack" text={params.repositories.summary}/><Text id="repositoryCheckedStack" text={params.repositories.checked} variant="caption" tone="muted"/><If id="repositoryActionStack" when={params.repositories.canCheck}><Column id="repositoryActionContentStack" gap="4dp"><Button id="repositoryCheckNowStack" text={params.repositories.checkLabel} enabled={params.repositories.checkEnabled} onClick={actions.checkRepositories}/><Status id="repositoryCheckMessageStack" text={params.repositories.checkMessage} tone="muted"/></Column></If><Text id="repositoryLastCleanStack" text={params.repositories.lastClean} variant="caption" tone="muted"/></Column></If></Column></Width>
</Column></If>
<If id="withoutRepository" when={!params.repositories.visible}><Column id="storageOnly" gap="12dp"><Text id="storageHeadingOnly" text="Storage" variant="heading"/><Text id="storageNoteOnly" text="Available disk space" variant="caption" tone="muted"/>
<Width id="storagewideOnly" min="800dp"><For id="diskswideOnly" items={params.disks} key={item.id} columns={3} gap="12dp"><Column id="diskwideOnly" surface="card" padding="16dp" gap="4dp"><Text id="mountwideOnly" text={item.mount}/><Text id="freewideOnly" text={item.value} variant="metric" tone={item.tone}/><Text id="capacitywideOnly" text={item.detail} variant="caption" tone="muted"/><Text id="devicewideOnly" text={item.device} variant="caption" tone="muted"/></Column></For></Width>
<Width id="storagemediumOnly" min="480dp" max="800dp"><For id="disksmediumOnly" items={params.disks} key={item.id} columns={2} gap="12dp"><Column id="diskmediumOnly" surface="card" padding="16dp" gap="4dp"><Text id="mountmediumOnly" text={item.mount}/><Text id="freemediumOnly" text={item.value} variant="metric" tone={item.tone}/><Text id="capacitymediumOnly" text={item.detail} variant="caption" tone="muted"/><Text id="devicemediumOnly" text={item.device} variant="caption" tone="muted"/></Column></For></Width>
<Width id="storagenarrowOnly" max="480dp"><For id="disksnarrowOnly" items={params.disks} key={item.id} columns={1} gap="12dp"><Column id="disknarrowOnly" surface="card" padding="16dp" gap="4dp"><Text id="mountnarrowOnly" text={item.mount}/><Text id="freenarrowOnly" text={item.value} variant="metric" tone={item.tone}/><Text id="capacitynarrowOnly" text={item.detail} variant="caption" tone="muted"/><Text id="devicenarrowOnly" text={item.device} variant="caption" tone="muted"/></Column></For></Width>
</Column></If>
</Column>
