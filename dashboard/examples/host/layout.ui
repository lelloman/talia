<Column id="overview" gap="20dp">
<Column id="health" gap="6dp"><Row id="identity" gap="12dp"><Text id="hostname" text={params.host} variant="heading"/><Status id="status" text={params.status} tone={params.statusTone}/></Row><Text id="updated" text={params.updated} variant="caption" tone="muted"/></Column>
<Width id="metricswide" min="640dp"><Grid id="metricsGridwide" columns={2} gap="16dp"><Use id="cpuwide" definition="host-metric-card" params={params.cpu}/><Use id="memorywide" definition="host-metric-card" params={params.memory}/></Grid></Width>
<Width id="metricsnarrow" max="640dp"><Grid id="metricsGridnarrow" columns={1} gap="16dp"><Use id="cpunarrow" definition="host-metric-card" params={params.cpu}/><Use id="memorynarrow" definition="host-metric-card" params={params.memory}/></Grid></Width>
<Width id="lowerWide" min="900dp"><Column id="lowerWideContent"><If id="lowerWithRepositories" when={params.repositories.visible}><Grid id="lowerWideGrid" columns={2} gap="16dp"><Column id="storageWide" surface="card" padding="20dp" gap="16dp"><Row id="storageTopWide" gap="8dp"><Text id="storageTitleWide" text="Storage"/><Text id="storageNoteWide" text="Free space per mount" variant="caption" tone="muted"/></Row><For id="disksWide" items={params.disks} key={item.id} gap="16dp"><Column id="diskWide" gap="6dp"><Row id="diskTopWide" gap="8dp"><Text id="mountWide" text={item.mount}/><Text id="freeWide" text={item.free} tone={item.tone}/></Row><Meter id="diskMeterWide" value={item.used} label={item.meterLabel} tone={item.tone}/><Text id="diskDetailWide" text={item.summary} variant="caption" tone="muted"/></Column></For></Column><Column id="repositoryCardWide" surface="card" padding="20dp" gap="12dp"><Row id="repositoryTopWide" gap="8dp"><Text id="repositoryTitleWide" text="Repositories"/><Text id="repositoryNoteWide" text="Git worktrees · checked daily" variant="caption" tone="muted"/></Row><Status id="repositoryStatusWide" text={params.repositories.title} tone={params.repositories.tone}/><Text id="repositorySummaryWide" text={params.repositories.summary}/><Column id="repositoryMetaWide" gap="2dp"><Text id="repositoryCheckedWide" text={params.repositories.checked} variant="caption" tone="muted"/><Text id="repositoryLastCleanWide" text={params.repositories.lastClean} variant="caption" tone="muted"/></Column><If id="repositoryActionWide" when={params.repositories.canCheck}><Column id="repositoryActionContentWide" gap="6dp"><Button id="repositoryCheckNowWide" text={params.repositories.checkLabel} enabled={params.repositories.checkEnabled} onClick={actions.checkRepositories}/><Status id="repositoryCheckMessageWide" text={params.repositories.checkMessage} tone="muted"/></Column></If></Column></Grid></If><If id="lowerStorageOnly" when={!params.repositories.visible}><Column id="storageWideOnly" surface="card" padding="20dp" gap="16dp"><Row id="storageTopWideOnly" gap="8dp"><Text id="storageTitleWideOnly" text="Storage"/><Text id="storageNoteWideOnly" text="Free space per mount" variant="caption" tone="muted"/></Row><For id="disksWideOnly" items={params.disks} key={item.id} gap="16dp" columns={2}><Column id="diskWideOnly" gap="6dp"><Row id="diskTopWideOnly" gap="8dp"><Text id="mountWideOnly" text={item.mount}/><Text id="freeWideOnly" text={item.free} tone={item.tone}/></Row><Meter id="diskMeterWideOnly" value={item.used} label={item.meterLabel} tone={item.tone}/><Text id="diskDetailWideOnly" text={item.summary} variant="caption" tone="muted"/></Column></For></Column></If></Column></Width>
<Width id="lowerNarrow" max="900dp"><Column id="lowerNarrowContent" gap="16dp"><Column id="storageNarrow" surface="card" padding="20dp" gap="16dp"><Row id="storageTopNarrow" gap="8dp"><Text id="storageTitleNarrow" text="Storage"/><Text id="storageNoteNarrow" text="Free space per mount" variant="caption" tone="muted"/></Row><For id="disksNarrow" items={params.disks} key={item.id} gap="16dp"><Column id="diskNarrow" gap="6dp"><Row id="diskTopNarrow" gap="8dp"><Text id="mountNarrow" text={item.mount}/><Text id="freeNarrow" text={item.free} tone={item.tone}/></Row><Meter id="diskMeterNarrow" value={item.used} label={item.meterLabel} tone={item.tone}/><Text id="diskDetailNarrow" text={item.summary} variant="caption" tone="muted"/></Column></For></Column><If id="narrowRepositories" when={params.repositories.visible}><Column id="repositoryCardNarrow" surface="card" padding="20dp" gap="12dp"><Row id="repositoryTopNarrow" gap="8dp"><Text id="repositoryTitleNarrow" text="Repositories"/><Text id="repositoryNoteNarrow" text="Git worktrees · checked daily" variant="caption" tone="muted"/></Row><Status id="repositoryStatusNarrow" text={params.repositories.title} tone={params.repositories.tone}/><Text id="repositorySummaryNarrow" text={params.repositories.summary}/><Column id="repositoryMetaNarrow" gap="2dp"><Text id="repositoryCheckedNarrow" text={params.repositories.checked} variant="caption" tone="muted"/><Text id="repositoryLastCleanNarrow" text={params.repositories.lastClean} variant="caption" tone="muted"/></Column><If id="repositoryActionNarrow" when={params.repositories.canCheck}><Column id="repositoryActionContentNarrow" gap="6dp"><Button id="repositoryCheckNowNarrow" text={params.repositories.checkLabel} enabled={params.repositories.checkEnabled} onClick={actions.checkRepositories}/><Status id="repositoryCheckMessageNarrow" text={params.repositories.checkMessage} tone="muted"/></Column></If></Column></If></Column></Width>
</Column>
