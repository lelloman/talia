{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionPage",
  "type": "object",
  "properties": {
    "next_cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Session"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "sessions"
  ],
  "$defs": {
    "BindingRevision": {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "binding_id",
        "revision"
      ]
    },
    "Capability": {
      "type": "string",
      "enum": [
        "network",
        "repository_read",
        "repository_write",
        "external_mutation",
        "human_input",
        "session_resume"
      ]
    },
    "Counter": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "EffectiveConfiguration": {
      "type": "object",
      "properties": {
        "binding_revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BindingRevision"
          }
        },
        "budget": {
          "$ref": "#/$defs/ResourceBudget"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true
        },
        "engine": {
          "$ref": "#/$defs/Id"
        },
        "engine_version": {
          "type": "string"
        },
        "profile_revision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "profile_revision",
        "engine",
        "engine_version",
        "capabilities",
        "binding_revisions",
        "budget"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "ResourceBudget": {
      "type": "object",
      "properties": {
        "cpu_time_secs": {
          "$ref": "#/$defs/Counter"
        },
        "evidence_bytes": {
          "$ref": "#/$defs/Counter"
        },
        "max_processes": {
          "$ref": "#/$defs/Counter"
        },
        "memory_bytes": {
          "$ref": "#/$defs/Counter"
        },
        "retention_secs": {
          "$ref": "#/$defs/Counter"
        },
        "wall_time_secs": {
          "$ref": "#/$defs/Counter"
        },
        "workspace_bytes": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "wall_time_secs",
        "cpu_time_secs",
        "memory_bytes",
        "max_processes",
        "workspace_bytes",
        "evidence_bytes",
        "retention_secs"
      ]
    },
    "Session": {
      "type": "object",
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "caller_id": {
          "$ref": "#/$defs/Id"
        },
        "created_at_ms": {
          "$ref": "#/$defs/Counter"
        },
        "effective": {
          "$ref": "#/$defs/EffectiveConfiguration"
        },
        "profile_id": {
          "$ref": "#/$defs/Id"
        },
        "resource_version": {
          "$ref": "#/$defs/Counter"
        },
        "retain_until_ms": {
          "description": "Null while nonterminal; a terminal deadline is frozen at settlement.",
          "anyOf": [
            {
              "$ref": "#/$defs/Counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "$ref": "#/$defs/Id"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "state": {
          "$ref": "#/$defs/SessionState"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 1,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "session_id",
        "caller_id",
        "source",
        "profile_id",
        "state",
        "resource_version",
        "effective",
        "created_at_ms"
      ]
    },
    "SessionState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_for_input",
        "pausing",
        "paused",
        "cancelling",
        "interrupted",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "SourceReference": {
      "type": "object",
      "properties": {
        "reference": {
          "$ref": "#/$defs/Id"
        },
        "system": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "required": [
        "system",
        "reference"
      ]
    }
  }
}
