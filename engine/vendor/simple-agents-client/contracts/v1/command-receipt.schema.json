{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandReceipt",
  "type": "object",
  "properties": {
    "command_id": {
      "$ref": "#/$defs/Id"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_version": {
      "$ref": "#/$defs/Counter"
    },
    "session_id": {
      "$ref": "#/$defs/Id"
    },
    "status": {
      "$ref": "#/$defs/CommandStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "command_id",
    "session_id",
    "status",
    "resource_version"
  ],
  "$defs": {
    "CommandStatus": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "rejected"
      ]
    },
    "Counter": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unsupported_version",
        "unauthorized",
        "forbidden",
        "not_found",
        "idempotency_conflict",
        "stale_version",
        "invalid_state",
        "request_expired",
        "capacity_unavailable",
        "evidence_expired",
        "cursor_expired",
        "unavailable",
        "internal"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    }
  }
}
