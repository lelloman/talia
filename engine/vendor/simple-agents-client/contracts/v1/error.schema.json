{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorResponse",
  "type": "object",
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorCode"
    },
    "message": {
      "type": "string"
    },
    "request_id": {
      "$ref": "#/$defs/Id"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "error",
    "message",
    "request_id",
    "retryable"
  ],
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "unsupported_version",
        "unauthorized",
        "forbidden",
        "not_found",
        "idempotency_conflict",
        "stale_version",
        "invalid_state",
        "request_expired",
        "capacity_unavailable",
        "evidence_expired",
        "cursor_expired",
        "unavailable",
        "internal"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    }
  }
}
