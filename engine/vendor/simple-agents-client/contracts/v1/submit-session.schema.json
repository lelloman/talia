{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubmitSession",
  "type": "object",
  "properties": {
    "binding_ids": {
      "description": "Service-configured capability binding IDs; never paths, commands or credentials.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "budget": {
      "$ref": "#/$defs/ResourceBudget"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "uniqueItems": true
    },
    "handoff": {
      "description": "Optional managed handoff protocol. Omission preserves legacy submissions.",
      "anyOf": [
        {
          "$ref": "#/$defs/ManagedHandoff"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "$ref": "#/$defs/Id"
    },
    "profile_id": {
      "$ref": "#/$defs/Id"
    },
    "source": {
      "$ref": "#/$defs/SourceReference"
    },
    "version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 1,
      "minimum": 1
    },
    "work": {
      "$ref": "#/$defs/WorkInput"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "idempotency_key",
    "source",
    "profile_id",
    "work",
    "capabilities",
    "binding_ids",
    "budget"
  ],
  "$defs": {
    "Capability": {
      "type": "string",
      "enum": [
        "network",
        "repository_read",
        "repository_write",
        "external_mutation",
        "human_input",
        "session_resume"
      ]
    },
    "Condition": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "outcome",
        "source",
        "revision",
        "text"
      ]
    },
    "Counter": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "ManagedHandoff": {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/Id"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "snapshot_id": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "binding_id",
        "snapshot_id",
        "conditions"
      ]
    },
    "ResourceBudget": {
      "type": "object",
      "properties": {
        "cpu_time_secs": {
          "$ref": "#/$defs/Counter"
        },
        "evidence_bytes": {
          "$ref": "#/$defs/Counter"
        },
        "max_processes": {
          "$ref": "#/$defs/Counter"
        },
        "memory_bytes": {
          "$ref": "#/$defs/Counter"
        },
        "retention_secs": {
          "$ref": "#/$defs/Counter"
        },
        "wall_time_secs": {
          "$ref": "#/$defs/Counter"
        },
        "workspace_bytes": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "wall_time_secs",
        "cpu_time_secs",
        "memory_bytes",
        "max_processes",
        "workspace_bytes",
        "evidence_bytes",
        "retention_secs"
      ]
    },
    "SourceReference": {
      "type": "object",
      "properties": {
        "reference": {
          "$ref": "#/$defs/Id"
        },
        "system": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "required": [
        "system",
        "reference"
      ]
    },
    "WorkInput": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string",
          "maxLength": 4194304
        },
        "instructions": {
          "type": "string",
          "maxLength": 1048576,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "instructions",
        "context"
      ]
    }
  }
}
