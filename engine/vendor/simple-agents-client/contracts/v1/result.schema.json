{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionResult",
  "type": "object",
  "properties": {
    "artifact_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EffectReceipt"
      }
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary",
    "artifact_ids",
    "effect_receipts"
  ],
  "$defs": {
    "EffectReceipt": {
      "type": "object",
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/Id"
        },
        "evidence": true,
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "$ref": "#/$defs/EffectStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "binding_id",
        "status",
        "evidence"
      ]
    },
    "EffectStatus": {
      "type": "string",
      "enum": [
        "applied",
        "not_applied",
        "uncertain"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "Outcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    }
  }
}
