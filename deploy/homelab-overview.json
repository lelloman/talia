    "document": {
      "source": "<Column id=\"card\" gap=\"8dp\" padding=\"12dp\"><Text id=\"title\" text={params.label}/><Status id=\"value\" text={params.value}/><Chart id=\"trend\" values={params.history} label={params.chartLabel} height=\"200dp\"/></Column>"
