  {
    "op": "put",
    "key": {
      "kind": "monitor_definition",
      "id": "homelab-collect"
    },
    "document": {
      "id": "homelab-collect",
      "version": 1,
      "kind": "pipeline",
      "source": "{async run(ctx){\n const q=ctx.params.queries,end=ctx.now()/1000;\n const result=await Promise.all([ctx.source('prom',{kind:'query',query:q.cpu}),ctx.source('prom',{kind:'query',query:q.memory}),ctx.source('prom',{kind:'query',query:q.disk}),ctx.source('prom',{kind:'query',query:q.targets}),ctx.source('prom',{kind:'range',query:q.cpu,start:end-3600,end,step:300}),ctx.source('prom',{kind:'range',query:q.memory,start:end-3600,end,step:300})]);\n const number=s=>s&&s.samples.length&&Number.isFinite(s.samples[0][1])?s.samples[0][1]:null;\n const targets=ctx.params.targets.map(t=>{const s=result[3].result.find(s=>s.metric.job===t.job&&s.metric.instance===t.instance);const n=number(s);return {...t,status:n===1?'up':n===0?'down':'unknown'};});\n for(const s of result[3].result){const id=s.metric.job+'|'+s.metric.instance;if(!targets.some(t=>t.id===id)){const n=number(s);targets.push({id,job:s.metric.job,instance:s.metric.instance,name:s.metric.job,status:n===1?'up':n===0?'down':'unknown'});}}\n const host=targets.some(t=>t.job==='node-exporter'&&t.status==='up');\n const history=r=>(r.result[0]?r.result[0].samples:[]).map(s=>s[1]).filter(Number.isFinite).map(n=>Math.round(n*10)/10);\n const disks=result[2].result.map(s=>({id:s.metric.instance+'|'+s.metric.device+'|'+s.metric.mountpoint,mount:s.metric.mountpoint,device:s.metric.device,free:host?number(s):null})).sort((a,b)=>a.mount.localeCompare(b.mount));\n const currentDisks=disks.map(d=>d.mount);\n for(const mount of ['/','/mnt/external','/boot/efi'])if(!currentDisks.includes(mount))disks.push({id:'missing:'+mount,mount,device:'not reported',free:null});\n await ctx.publish('summary',{updated:ctx.now(),cpu:host?number(result[0].result[0]):null,memory:host?number(result[1].result[0]):null,disks,targets,cpuHistory:history(result[4]),memoryHistory:history(result[5])});\n}}"
    }
  },
