  {
    "op": "put",
    "key": {
      "kind": "dashboard",
      "id": "monitor"
    },
    "document": {
      "ui": "<Dashboard id=\"monitor\"><Surface id=\"main\"><Scroll id=\"scroll\"><Column id=\"overview\" gap=\"16dp\" padding=\"16dp\">\n<Text id=\"title\" text=\"Homelab overview\"/><Status id=\"status\" text={state.status}/><Text id=\"updated\" text={state.updated}/>\n<Width id=\"wide\" min=\"640dp\"><Grid id=\"metricsWide\" columns={2} gap=\"16dp\"><Use id=\"cpuWide\" definition=\"homelab-metric-card\" params={state.cpu}/><Use id=\"memoryWide\" definition=\"homelab-metric-card\" params={state.memory}/></Grid></Width>\n<Width id=\"narrow\" max=\"640dp\"><Column id=\"metricsNarrow\" gap=\"16dp\"><Use id=\"cpuNarrow\" definition=\"homelab-metric-card\" params={state.cpu}/><Use id=\"memoryNarrow\" definition=\"homelab-metric-card\" params={state.memory}/></Column></Width>\n<Text id=\"diskHeading\" text=\"Disk space available\"/><For id=\"disks\" items={state.disks} key={item.id}><Column id=\"disk\" gap=\"4dp\" padding=\"12dp\"><Text id=\"mount\" text={item.label}/><Status id=\"free\" text={item.value}/></Column></For>\n<Text id=\"servicesHeading\" text=\"Service metrics\"/><Status id=\"summary\" text={state.summary}/><Text id=\"scope\" text=\"Checks whether Prometheus can collect each service\u2019s metrics; this is not a full application health check.\"/>\n<For id=\"targets\" items={state.targets} key={item.id}><Column id=\"target\" gap=\"4dp\" padding=\"8dp\"><Status id=\"name\" text={item.label}/><Text id=\"instance\" text={item.detail}/></Column></For>\n</Column></Scroll></Surface></Dashboard>",
      "view_model": "defineVM({\n initial:()=>({status:'Waiting for Prometheus collection\u2026',updated:'',summary:'Waiting for target status\u2026',cpu:{label:'CPU usage',value:'Unavailable',history:[],chartLabel:'CPU % \u00b7 1 hour / 5-minute samples'},memory:{label:'Memory usage',value:'Unavailable',history:[],chartLabel:'Memory % \u00b7 1 hour / 5-minute samples'},disks:[],targets:[]}),\n async start(ctx){await ctx.subscribe('homelab-summary','snapshot');},\n actions:{snapshot(ctx,event){const sample=event.value,v=sample.value,s=ctx.state();if(!v||!Array.isArray(v.targets)){ctx.commit(s,{...s.value,status:'Waiting for the first valid collection\u2026'});return;}\n const pct=n=>Number.isFinite(n)?n.toFixed(1)+'%':'Unavailable';\n const good=sample.quality==='good';const up=v.targets.filter(t=>t.status==='up').length;\n ctx.commit(s,{...s.value,status:good?'Prometheus connected \u00b7 collected every 30 seconds':'Collection '+sample.quality+' \u00b7 showing the last available readings',updated:'Last collected: '+new Date(v.updated).toISOString().replace('T',' ').replace(/\\.\\d{3}Z$/,' UTC'),summary:up+' / '+v.targets.length+' service metrics reachable',cpu:{...s.value.cpu,value:pct(v.cpu),history:v.cpuHistory},memory:{...s.value.memory,value:pct(v.memory),history:v.memoryHistory},disks:v.disks.map(d=>({id:d.id,label:d.mount+' \u00b7 '+d.device,value:Number.isFinite(d.free)?pct(d.free)+' free':'Unavailable'})),targets:v.targets.map(t=>({id:t.id,label:(t.status==='up'?'OK':t.status==='down'?'UNREACHABLE':'NO RECENT DATA')+' \u00b7 '+t.name,detail:t.instance}))});\n }}\n});",
