{
  "id": "morning-homelab",
  "version": 1,
  "enabled": false,
  "schedule": {
    "kind": "daily",
    "time": "08:00",
    "zone": "Europe/Rome"
  },
  "period_ms": 86400000,
  "timeout_ms": 3600000,
  "steps": [
    {
      "id": "availability",
      "kind": "source",
      "source": "prometheus",
      "request": "ctx => ({kind:'query',query:'avg_over_time(up['+Math.floor((ctx.period.end-ctx.period.start)/1000)+'s])',time:ctx.period.end/1000})"
    },
    {
      "id": "facts",
      "kind": "script",
      "source": "ctx => { const data=ctx.decode(ctx.steps.availability.value.wire); return {series:data.result.map(s=>({labels:s.metric,availabilityPercent:Number.isFinite(s.samples[0]?.[1])?s.samples[0][1]*100:null})),warnings:data.warnings}; }"
    }
  ],
  "compose": "ctx => ({subject:'Tal\u00eca \u00b7 Morning homelab report',summary:'Availability observations for the reporting period. '+ctx.steps.facts.value.series.length+' series collected.',sections:[{title:'Availability observations',text:JSON.stringify(ctx.steps.facts.value,null,2)}]})",
  "destinations": [
    "my-email"
  ]
}
